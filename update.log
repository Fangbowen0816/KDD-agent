    {
      "update_id": "2026-05-14-agent-refine-and-dataengine-simplify",
      "status": "completed",
      "summary": "收紧 agent 工作流与提示词，简化 DataEngine 表名机制，并修复 JSON/SQLite 加载问题。",
      "changes": {
